<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NOVA AGENT 5.0"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#00E5FF"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Masukkan API Key Groq"
        android:textColorHint="#888888"
        android:textColor="#FFFFFF"
        android:background="#222222"
        android:padding="12dp"
        android:inputType="textPassword"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Model AI (Groq):"
        android:textColor="#00E5FF"
        android:layout_marginBottom="8dp"
        android:textStyle="bold"/>

<RadioGroup
    android:id="@+id/rgModel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="16dp">
    
    <RadioButton
        android:id="@+id/rbLlama31"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Llama 3.1 8B (Standar)"
        android:textColor="#FFFFFF"
        android:checked="true"/>
        
    <RadioButton
        android:id="@+id/rbLlamaLite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Llama 3 8B (Lite / Paling Stabil)"
        android:textColor="#FFFFFF"/>
        
    <RadioButton
        android:id="@+id/rbGemma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gemma 2 9B (Kecerdasan Google)"
        android:textColor="#FFFFFF"/>
</RadioGroup>

    <Button
        android:id="@+id/btnSaveKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SIMPAN KONFIGURASI"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status Perizinan Wajib:"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. AKTIFKAN AKSESIBILITAS"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. IZIN MENGAMBANG (OVERLAY)"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="3. MULAI NOVA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>
</LinearLayout>
