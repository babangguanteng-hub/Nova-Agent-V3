<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_main">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="25dp">
                
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nova Agent"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v6.0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#00E5FF"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart  •  Fast  •  Powerful"
                        android:textSize="12sp"
                        android:textColor="#88FFFFFF"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <ImageView android:id="@+id/btnSettings" android:layout_width="45dp" android:layout_height="45dp" android:src="@android:drawable/ic_menu_manage" android:tint="#FFFFFF" android:background="@drawable/bg_premium_input" android:padding="10dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:clickable="true" android:focusable="true"/>
            </RelativeLayout>

            <!-- CARD 1: PROVIDER AI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provider AI" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pilih penyedia layanan AI" android:textColor="#88FFFFFF" android:textSize="12sp" android:layout_marginBottom="12dp"/>
                
                <Spinner
                    android:id="@+id/spinnerProvider"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_premium_input"
                    android:popupBackground="#0B132B"/>
            </LinearLayout>

            <!-- CARD 2: API KEY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Key Omni-Rotator" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bisa >1, pisahkan koma (,)" android:textColor="#88FFFFFF" android:textSize="12sp" android:layout_marginBottom="12dp"/>
                
                <EditText
                    android:id="@+id/apiKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="gsk_..."
                    android:textColorHint="#40FFFFFF"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_premium_input"
                    android:paddingHorizontal="16dp"
                    android:inputType="textVisiblePassword"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSaveKey"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Simpan Konfigurasi"
                    android:textAllCaps="false"
                    android:backgroundTint="@null"
                    android:background="@drawable/bg_premium_button"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- CARD 3: MODEL AI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="16dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model AI Otomatis" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dipilih otomatis berdasarkan Provider" android:textColor="#88FFFFFF" android:textSize="12sp" android:layout_marginBottom="12dp"/>
                <RadioGroup android:id="@+id/rgModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"/>
                <TextView
                    android:id="@+id/tvAutoModel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="openai/gpt-oss-20b"
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:padding="12dp"
                    android:background="@drawable/bg_premium_input"
                    android:gravity="center_vertical"/>
            </LinearLayout>

            <!-- CARD 4: PERMISSIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="30dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Status Perizinan Wajib" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sistem Otonom" android:textColor="#88FFFFFF" android:textSize="12sp" android:layout_marginBottom="12dp"/>
                
                <RelativeLayout android:id="@+id/btnAccessibility" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_premium_input" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Aksesibilitas" android:textColor="#FFF" android:textSize="14sp" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                    <TextView android:id="@+id/tvStatusA11y" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cek" android:background="@drawable/bg_premium_badge" android:textColor="#00FF73" android:textSize="10sp" android:textStyle="bold" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="12dp"/>
                </RelativeLayout>

                <RelativeLayout android:id="@+id/btnOverlay" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_premium_input" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Tampil di Atas" android:textColor="#FFF" android:textSize="14sp" android:layout_centerVertical="true" android:layout_marginStart="16dp"/>
                    <TextView android:id="@+id/tvStatusOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cek" android:background="@drawable/bg_premium_badge" android:textColor="#00FF73" android:textSize="10sp" android:textStyle="bold" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="12dp"/>
                </RelativeLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:backgroundTint="@null"
                android:background="@drawable/bg_premium_button"
                android:text="▶ Mulai Nova"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp"
                android:elevation="8dp"/>

            <TextView
                android:id="@+id/tvDeveloperCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Developed by\nMOCH KHOIRUL AZMAN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:letterSpacing="0.1"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
