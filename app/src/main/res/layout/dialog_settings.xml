<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_cyber"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan Nova"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 1. MODEL SUARA -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Model Suara" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <RadioGroup android:id="@+id/rgVoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_edit_text" android:padding="10dp" android:layout_marginBottom="16dp">
            <RadioButton android:id="@+id/rbVoiceJarvis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Natural (Pria Besar)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="6dp"/>
            <RadioButton android:id="@+id/rbVoiceNova" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Default (Standar)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="6dp"/>
            <RadioButton android:id="@+id/rbVoiceFriday" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expressive (Imut)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="6dp"/>
            <RadioButton android:id="@+id/rbVoiceRobot" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Premium (Robot)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="6dp"/>
        </RadioGroup>

        <!-- 2. WARNA BUBBLE JELLY -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warna Bubble Jelly" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <RadioGroup android:id="@+id/rgColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_edit_text" android:padding="10dp" android:layout_marginBottom="16dp">
            <RadioButton android:id="@+id/rbColorCyan" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cyan Glow" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="6dp"/>
            <RadioButton android:id="@+id/rbColorPurple" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Neon Purple" android:textColor="#FFF" android:buttonTint="#B000FF" android:padding="6dp"/>
            <RadioButton android:id="@+id/rbColorRed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Crimson Red" android:textColor="#FFF" android:buttonTint="#FF003C" android:padding="6dp"/>
        </RadioGroup>

        <android.widget.CheckBox
            android:id="@+id/cbHologram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifikasi Pintar &amp; Aura Hologram"
            android:textColor="#FFFFFF"
            android:buttonTint="#00E5FF"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Simpan Pengaturan"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:background="@drawable/bg_start_glow"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"/>
            
    </LinearLayout>
</ScrollView>
