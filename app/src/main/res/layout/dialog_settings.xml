<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan Suara &amp; Visual"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Model Suara"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>
            
        <RadioGroup
            android:id="@+id/rgVoicePitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_premium_input"
            android:padding="12dp"
            android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/rbVoiceJarvis" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pria Besar (Wibawa)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="8dp"/>
            <RadioButton android:id="@+id/rbVoiceNova" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Normal (Standar)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="8dp"/>
            <RadioButton android:id="@+id/rbVoiceFriday" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Imut (Ekspresif)" android:textColor="#FFF" android:buttonTint="#00E5FF" android:padding="8dp"/>
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan Lainnya"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Dummy visual settings to match design vibe -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_premium_input" android:padding="16dp" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Animasi Booble Jelly" android:textColor="#FFF"/>
            <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
        </LinearLayout>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_premium_input" android:padding="16dp" android:layout_marginBottom="24dp">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mode Hemat Daya" android:textColor="#FFF"/>
            <Switch android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Simpan Pengaturan"
            android:textAllCaps="false"
            android:backgroundTint="@null"
            android:background="@drawable/bg_premium_button"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"/>
            
    </LinearLayout>
</ScrollView>
