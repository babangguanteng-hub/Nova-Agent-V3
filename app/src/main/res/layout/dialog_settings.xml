<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_cyber"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PENGATURAN SUARA NOVA"
        android:textColor="#00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:layout_gravity="center_horizontal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Karakter Suara (Pitch):"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>
        
    <RadioGroup
        android:id="@+id/rgVoicePitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton android:id="@+id/rbVoiceJarvis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pria Besar" android:textColor="#FFF" android:buttonTint="#00E5FF"/>
        <RadioButton android:id="@+id/rbVoiceNova" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:textColor="#FFF" android:buttonTint="#00E5FF"/>
        <RadioButton android:id="@+id/rbVoiceFriday" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Imut" android:textColor="#FFF" android:buttonTint="#00E5FF"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="SIMPAN PENGATURAN"
        android:backgroundTint="#00E5FF"
        android:textColor="#000"
        android:textStyle="bold"
        android:layout_marginTop="10dp"/>
</LinearLayout>
