private View closeTargetView;
private WindowManager.LayoutParams closeParams;

private boolean isAdded = false;
private boolean isListeningMode = true; 
private AnimatorSet pulseAnimator;
private String customColor = "cyan";
private String customShape = "circle";
private String customAnim = "breathe";
private int sizePct = 75;
private int alphaPct = 85;

public FloatingBubbleView(Context context) {
    this.context = context;
    this.windowManager = (WindowManager) context.getSystemService(Context.WINDOW_SERVICE);
    EventBus.getInstance().subscribe(AgentEvent.EventType.STATE_CHANGED, this);
    initView();
    initCloseTarget();
}

private void playUISound(int soundEffectType) {
    AudioManager am = (AudioManager) context.getSystemService(Context.AUDIO_SERVICE);
    if (am != null) am.playSoundEffect(soundEffectType, 1.0f);
}

private void initCloseTarget() {
    closeTargetView = LayoutInflater.from(context).inflate(R.layout.layout_close_target, null);
    int layoutFlag = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY : WindowManager.LayoutParams.TYPE_PHONE;
    closeParams = new WindowManager.LayoutParams(
        WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT,
        layoutFlag, WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE, PixelFormat.TRANSLUCENT);
    closeParams.gravity = Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL;
    closeParams.y = 150;
}

private void initView() {
    bubbleView = LayoutInflater.from(context).inflate(R.layout.layout_floating_bubble, null);
    jellyBg = bubbleView.findViewById(R.id.jellyBg);
    jellyFace = bubbleView.findViewById(R.id.jellyFace);
    panelExpand = bubbleView.findViewById(R.id.panelExpand);
    tvStatus = bubbleView.findViewById(R.id.tvStatus);

    reloadAndApplySettings();

    bubbleView.setOnClickListener(v -> {
        playUISound(AudioManager.FX_KEY_CLICK);
        isListeningMode = !isListeningMode;
        if (isListeningMode) {
            float alpha = Math.max(0.2f, alphaPct / 100.0f);
            jellyBg.setAlpha(alpha);
            jellyFace.setAlpha(alpha);
            if (pulseAnimator != null && !"static".equals(customAnim)) pulseAnimator.resume();
            EventBus.getInstance().publish(new AgentEvent(AgentEvent.EventType.STATE_CHANGED, "RESUME_LISTENING"));
            setStatus("MENDENGARKAN...");
        } else {
            jellyBg.setAlpha(0.3f);
            jellyFace.setAlpha(0.3f);
            if (pulseAnimator != null) pulseAnimator.pause();
            setStatus("NOVA TIDUR");
            try { ServiceLocator.getInstance().resolve(AutonomousLoopEngine.class).stopTask(); } catch (Exception e) {}
        }
    });

    bubbleView.setOnTouchListener(new View.OnTouchListener() {
        private int initialX, initialY;
        private float initialTouchX, initialTouchY;
        private WindowManager.LayoutParams params;
        private boolean isDragging = false;
        
        @Override public boolean onTouch(View v, MotionEvent event) {
            if (params == null) params = (WindowManager.LayoutParams) bubbleView.getLayoutParams();
            DisplayMetrics metrics = context.getResources().getDisplayMetrics();
            
            switch (event.getAction()) {
                case MotionEvent.ACTION_DOWN:
                    isDragging = false;
                    initialX = params.x; initialY = params.y;
                    initialTouchX = event.getRawX(); initialTouchY = event.getRawY();
                    if (closeTargetView.getParent() == null) windowManager.addView(closeTargetView, closeParams);
                    return false; 
                    
                case MotionEvent.ACTION_MOVE:
                    int diffX = (int) (event.getRawX() - initialTouchX);
                    int diffY = (int) (event.getRawY() - initialTouchY);
                    if (Math.abs(diffX) > 10 || Math.abs(diffY) > 10) isDragging = true;
                    params.x = initialX + diffX;
                    params.y = initialY + diffY;
                    windowManager.updateViewLayout(bubbleView, params);
                    
                    if (params.y > metrics.heightPixels - 500) {
                        closeTargetView.setScaleX(1.3f); closeTargetView.setScaleY(1.3f);
                        closeTargetView.setAlpha(1.0f);
                    } else {
                        closeTargetView.setScaleX(1.0f); closeTargetView.setScaleY(1.0f);
                        closeTargetView.setAlpha(0.7f);
                    }
                    return true;
                    
                case MotionEvent.ACTION_UP:
                    if (closeTargetView.getParent() != null) windowManager.removeView(closeTargetView);
                    if (params.y > metrics.heightPixels - 500) {
                        playUISound(AudioManager.FX_KEYPRESS_DELETE);
                        isListeningMode = false;
                        context.stopService(new Intent(context, NovaForegroundService.class));
                    }
                    return isDragging;
            }
            return false;
        }
    });
}

public void reloadAndApplySettings() {
    SharedPreferences prefs = context.getSharedPreferences("nova_config", Context.MODE_PRIVATE);
    this.customColor = prefs.getString("custom_color", "cyan");
    this.customShape = prefs.getString("custom_shape", "circle");
    boolean powerSave = prefs.getBoolean("power_save", false);
    boolean masterAnim = prefs.getBoolean("bubble_master", true);
    this.customAnim = (powerSave || !masterAnim) ? "static" : prefs.getString("custom_anim", "breathe");
    this.sizePct = prefs.getInt("bubble_size_pct", 75);
    this.alphaPct = prefs.getInt("bubble_alpha_pct", 85);

    int baseColor = Color.parseColor("#00E5FF");
    if ("red".equals(customColor)) baseColor = Color.parseColor("#FF4D8D");
    else if ("green".equals(customColor)) baseColor = Color.parseColor("#52B788");
    else if ("purple".equals(customColor)) baseColor = Color.parseColor("#9D4EDD");
    else if ("orange".equals(customColor)) baseColor = Color.parseColor("#FFAA00");

    // Terapkan Bentuk (Shape) & Warna
    if ("star".equals(customShape)) {
        jellyBg.setBackgroundResource(R.drawable.ic_shape_star);
        jellyBg.getBackground().setTint(baseColor);
    } else if ("heart".equals(customShape)) {
        jellyBg.setBackgroundResource(R.drawable.ic_shape_heart);
        jellyBg.getBackground().setTint(baseColor);
    } else if ("square".equals(customShape)) {
        GradientDrawable sq = new GradientDrawable();
        sq.setShape(GradientDrawable.RECTANGLE);
        sq.setCornerRadius(28f);
        sq.setColor(baseColor);
        sq.setStroke(4, Color.WHITE);
        jellyBg.setBackground(sq);
    } else {
        GradientDrawable oval = new GradientDrawable();
        oval.setShape(GradientDrawable.OVAL);
        oval.setColor(baseColor);
        oval.setStroke(4, Color.WHITE);
        jellyBg.setBackground(oval);
    }

    // Terapkan Ukuran (Size)
    float density = context.getResources().getDisplayMetrics().density;
    int pixelSize = Math.round((45 + (sizePct * 0.4f)) * density);
    ViewGroup.LayoutParams bgParams = jellyBg.getLayoutParams();
    ViewGroup.LayoutParams faceParams = jellyFace.getLayoutParams();
    if (bgParams != null && faceParams != null) {
        bgParams.width = pixelSize;
        bgParams.height = pixelSize;
        faceParams.width = pixelSize;
        faceParams.height = pixelSize;
        jellyBg.setLayoutParams(bgParams);
        jellyFace.setLayoutParams(faceParams);
    }

    // Terapkan Transparansi (Alpha)
    float alpha = Math.max(0.2f, alphaPct / 100.0f);
    jellyBg.setAlpha(alpha);
    jellyFace.setAlpha(alpha);

    // Terapkan Animasi
    if (pulseAnimator != null) {
        pulseAnimator.cancel();
        pulseAnimator = null;
    }
    if (!"static".equals(customAnim)) {
        startJellyPulseAnimation();
    }
}

private void startJellyPulseAnimation() {
    ObjectAnimator scaleX = ObjectAnimator.ofFloat(jellyBg, "scaleX", 1f, 1.14f, 1f);
    ObjectAnimator scaleY = ObjectAnimator.ofFloat(jellyBg, "scaleY", 1f, 1.06f, 1f);
    ObjectAnimator scaleFaceX = ObjectAnimator.ofFloat(jellyFace, "scaleX", 1f, 1.14f, 1f);
    ObjectAnimator scaleFaceY = ObjectAnimator.ofFloat(jellyFace, "scaleY", 1f, 1.06f, 1f);

    long duration = 1200;
    if ("heartbeat".equals(customAnim)) {
        duration = 450;
        scaleX.setInterpolator(new BounceInterpolator());
    } else if ("glitch".equals(customAnim)) {
        duration = 250;
        scaleX.setFloatValues(1f, 1.25f, 0.85f, 1.1f, 1f);
    }

    scaleX.setRepeatCount(ValueAnimator.INFINITE); scaleY.setRepeatCount(ValueAnimator.INFINITE);
    scaleFaceX.setRepeatCount(ValueAnimator.INFINITE); scaleFaceY.setRepeatCount(ValueAnimator.INFINITE);
    scaleX.setDuration(duration); scaleY.setDuration(duration);
    scaleFaceX.setDuration(duration); scaleFaceY.setDuration(duration);

    pulseAnimator = new AnimatorSet();
    pulseAnimator.playTogether(scaleX, scaleY, scaleFaceX, scaleFaceY);
    pulseAnimator.start();
}

private void setStatus(String text) {
    if (tvStatus != null && panelExpand != null) {
        tvStatus.post(() -> {
            panelExpand.setVisibility(View.VISIBLE);
            tvStatus.setText(text);
            if (!text.startsWith("ðŸ—£ï¸")) {
                tvStatus.postDelayed(() -> {
                    if (tvStatus.getText().toString().equals(text)) panelExpand.setVisibility(View.GONE);
                }, 3500);
            }
        });
    }
}

public void show() {
    if (isAdded) return;
    int layoutFlag = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O ? WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY : WindowManager.LayoutParams.TYPE_PHONE;
    WindowManager.LayoutParams params = new WindowManager.LayoutParams(WindowManager.LayoutParams.WRAP_CONTENT, WindowManager.LayoutParams.WRAP_CONTENT, layoutFlag, WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE, PixelFormat.TRANSLUCENT);
    params.gravity = Gravity.TOP | Gravity.START; params.x = 20; params.y = 200;
    try { windowManager.addView(bubbleView, params); isAdded = true; } catch (Exception e) {}
}

public void remove() {
    isListeningMode = false;
    if (isAdded && bubbleView != null) { try { windowManager.removeView(bubbleView); } catch (Exception e) {} isAdded = false; }
    EventBus.getInstance().unsubscribe(AgentEvent.EventType.STATE_CHANGED, this);
}

@Override
public void onEvent(AgentEvent event) {
    if (event.type == AgentEvent.EventType.STATE_CHANGED) {
        String state = String.valueOf(event.payload);
        
        if ("SETTINGS_UPDATED".equals(state)) {
            bubbleView.post(this::reloadAndApplySettings);
        }
        else if (state.startsWith("RMS:")) {
            if (!isListeningMode || "static".equals(customAnim)) return;
            try {
                float rms = Float.parseFloat(state.substring(4));
                float targetScale = 1.0f + (Math.max(0, rms) / 15.0f);
                if (targetScale > 1.55f) targetScale = 1.55f;
                
                final float finalScale = targetScale;
                bubbleView.post(() -> {
                    jellyBg.animate().scaleX(finalScale).scaleY(finalScale)
                           .setDuration(90).setInterpolator(new AccelerateDecelerateInterpolator()).start();
                    jellyFace.animate().scaleX(finalScale).scaleY(finalScale)
                           .setDuration(90).start();
                });
            } catch (Exception e){}
        } 
        else if (state.startsWith("PARTIAL:")) {
            String partial = state.substring(8);
            setStatus("ðŸ—£ï¸ " + partial + "...");
        }
        else if ("NOVA_SPEAKING_START".equals(state)) {
            jellyFace.post(() -> jellyFace.animate().rotationBy(360f).setDuration(900).start());
        }
        else if ("LISTENING_READY".equals(state)) {
            if (panelExpand != null) panelExpand.post(() -> panelExpand.setVisibility(View.GONE));
        }
        else if ("INTERRUPT_TRIGGERED".equals(state)) {
            setStatus("ðŸ›‘ DISela...");
            jellyBg.post(() -> jellyBg.animate().scaleX(1.35f).scaleY(1.35f).setDuration(150).start());
        }
    }
}

