<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubbleRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Wujud Virus Jelly -->
    <ImageView
        android:id="@+id/jellyBall"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_jelly_bubble"
        android:src="@android:drawable/ic_btn_speak_now"
        android:padding="12dp"
        android:elevation="8dp" />

    <!-- Panel Informasi (Tersembunyi, Muncul jika Jelly diketuk) -->
    <LinearLayout
        android:id="@+id/panelExpand"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_bubble_cyber"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENDENGARKAN..."
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#F44336"
            android:text="TIDUR (CLOSE)"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
